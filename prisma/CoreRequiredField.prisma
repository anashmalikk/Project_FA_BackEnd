model CoreRequiredField {
  id             String                  @id @default(cuid())
  registrationId String
  fieldName      String
  label          String?
  placeholder    String?
  fieldType      String
  mandatory      Boolean                 @default(true)
  required       Boolean                 @default(true)
  minLength      Int?
  maxLength      Int?
  pattern        String?
  defaultValue   String?
  helpText       String?
  displayOrder   Int                     @default(1)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  registration   RegistrationRequirement @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
}
