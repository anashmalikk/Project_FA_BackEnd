model Job {
  id                    String                   @id @default(cuid())
  apiId                 String?                  @unique
  organizationId        String
  title                 String
  visibility            String
  type                  JobType
  subtype               String?
  status                JobStatus
  region                Region
  publicUrl             String?
  seoUrl                String?
  description           String
  startDate             DateTime?
  endDate               DateTime?
  playersCount          Int?
  registerCount         Int?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  source                String                   @default("MANUAL")
  aboutCompany          String?
  jobDescription        String?
  experience            String?
  educationAndSkills    String?
  roleAndResponsibility String?
  applyUrl              String?
  postedDate            DateTime?
  displayConfig         DisplayConfiguration?
  organization          Organization             @relation(fields: [organizationId], references: [id])
  images                JobImage[]
  locations             JobLocation[]
  skills                JobSkill[]
  registration          RegistrationRequirement?
  rounds                Round[]
}
