model DisplayConfiguration {
  id              String  @id @default(cuid())
  jobId           String  @unique
  headerType      Int?
  footerType      Int?
  showTags        Boolean
  showRounds      Boolean
  showEligibility Boolean
  showGallery     Boolean
  showPrize       Boolean
  job             Job     @relation(fields: [jobId], references: [id])
}
